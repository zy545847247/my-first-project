page{background:#F8F7F2;color:#2C4439;font-family:-apple-system,BlinkMacSystemFont,'PingFang SC',sans-serif;font-size:30rpx}view,text,button,input{box-sizing:border-box}.page{padding:36rpx 32rpx 60rpx}.eyebrow{font-size:22rpx;letter-spacing:4rpx;color:#7A8D80}.title{font-size:54rpx;font-weight:650;line-height:1.35;margin:18rpx 0}.muted{color:#7A887F;font-size:26rpx;line-height:1.8}.section{font-size:36rpx;font-weight:600;margin:44rpx 0 24rpx}.panel{background:#FFF;border-radius:36rpx;padding:32rpx;margin:24rpx 0}.row{display:flex;align-items:center;justify-content:space-between}.grid{display:grid;grid-template-columns:1fr 1fr;gap:22rpx}.pill{background:#EAF0E8;padding:10rpx 20rpx;border-radius:30rpx;font-size:23rpx;color:#52705B}button{border:0;border-radius:28rpx;font-size:29rpx;line-height:1.5;padding:26rpx 24rpx;margin:0;background:#EEF2EC;color:#345A47}button::after{border:0}.primary{background:#3E705C;color:white}.empty{text-align:center;padding:64rpx 24rpx}.list-item{padding:24rpx 0;border-bottom:1rpx solid #EDF0EA}.small-art{font-size:64rpx;margin-right:24rpx}.count{font-size:46rpx;font-weight:650}.stat{text-align:center;flex:1}.category{min-height:245rpx;border-radius:34rpx;padding:28rpx}.category-name{font-size:32rpx;font-weight:600}.category-art{font-size:76rpx;display:block;margin-bottom:16rpx}.footer{margin-top:32rpx;text-align:center;font-size:23rpx;color:#87918B}.link{color:#3E705C;font-size:26rpx}.progress{height:12rpx;border-radius:12rpx;background:#E7EEE5;overflow:hidden;margin:22rpx 0}.progress-fill{height:100%;background:#83AC8C}
