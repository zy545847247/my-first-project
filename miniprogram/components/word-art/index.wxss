.art{height:410rpx;border-radius:48rpx;background:#F0F3E9;display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden}.emoji{font-size:210rpx}.image{width:85%;height:85%}.swatch{width:220rpx;height:220rpx;border-radius:60rpx;box-shadow:0 16rpx 0 rgba(0,0,0,.05)}.spark{position:absolute;font-size:44rpx;color:#D5B762}.one{top:48rpx;right:62rpx}.two{bottom:58rpx;left:50rpx}.bubble{position:absolute;width:28rpx;height:28rpx;border:4rpx solid #CBDAC7;border-radius:50%;right:60rpx;bottom:62rpx}.bounce{animation:pop .5s ease}.bounce .spark{animation:twinkle .5s ease}@keyframes pop{50%{transform:scale(1.035)}}@keyframes twinkle{50%{transform:scale(1.5);opacity:.5}}
