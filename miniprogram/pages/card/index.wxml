<view class="page" wx:if="{{word}}"><view class="row"><text class="eyebrow">LOOK · LISTEN · DISCOVER</text><text class="pill">{{index+1}} / {{total}}</text></view><view class="progress"><view class="progress-fill" style="width:{{(index+1)/total*100}}%"></view></view><word-art word="{{word}}" active="{{active}}" bind:activate="listen"/><view class="word"><view class="pinyin">{{word.pinyin}}</view><view class="name">{{word.name}}</view><text class="muted">{{word.description}}</text></view><button class="primary" bindtap="listen">{{playing ? '正在播放…' : '🔊 再听一次'}}</button><view class="actions"><button bindtap="favorite">{{favorite ? '★ 已收藏' : '☆ 收藏'}}</button><button bindtap="next">下一个 →</button></view><button wx:if="{{index>0}}" class="previous" bindtap="previous">← 上一个</button><view class="footer">{{word.audio ? '点点图片，听听它的名字' : '演示版 · 图片为示意素材，录音待补充'}}</view></view><view wx:else class="empty">没有找到这张词卡，请返回分类页。</view>