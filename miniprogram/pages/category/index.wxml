<view class="page"><text class="eyebrow">DISCOVER · 发现</text><view class="title">{{category.name}}</view><text class="muted">轻轻点一下，认识一个新朋友。</text><view class="grid tiles"><view wx:for="{{items}}" wx:key="id" class="tile" bindtap="open" data-id="{{item.id}}"><view class="mini-art" style="background:{{item.color || category.background}}"><text wx:if="{{!item.color}}">{{item.emoji}}</text></view><view class="row"><text>{{item.name}}</text><text class="seen" wx:if="{{item.viewed}}">看过</text></view><text class="muted">{{item.pinyin}}</text></view></view></view>